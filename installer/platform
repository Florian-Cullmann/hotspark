#!/usr/bin/env bash
set -Eeuo pipefail
[ "$(id -u)" -eq 0 ] || { echo 'Run as root.' >&2; exit 1; }
compose() { docker compose --env-file /etc/hotspark/platform.env --project-name hotspark -f /opt/hotspark/current/deployments/compose.yaml "$@"; }
case "${1:-help}" in
 uninstall)
  [ "${2:-}" = --platform-only ] || { echo 'Usage: platform uninstall --platform-only. Hosted containers, releases, configuration and ALL data are preserved.' >&2; exit 2; }
  exec 9>/var/lib/hotspark/operations/.update.lock
  flock -n 9
  compose down
  if [ "$(cat /var/lib/hotspark/buildkit/owner 2>/dev/null || true)" = hotspark-workloads ]; then
    DOCKER_CONFIG=/var/lib/hotspark/buildkit/docker-config docker buildx stop hotspark-workloads
  fi
  echo 'Platform containers removed. Hosted applications keep running, but public routing is offline. All persistent data, configuration, releases, the external proxy network and this command are preserved. See docs/installation.md for explicit removal procedures.'
  ;;
 *)
  install -d -m 0700 /var/lib/hotspark/cli
  # The operator wrapper uses Docker only to supply Node; all management requests use REST.
  version=$(sed -n 's/^HOTSPARK_VERSION=//p' /etc/hotspark/platform.env)
  terminal=()
  if [ -t 0 ] && [ -t 1 ]; then terminal=(-t); fi
  exec docker run --rm -i "${terminal[@]}" --network host --user "$(id -u):$(id -g)" --cap-drop ALL --security-opt no-new-privileges --read-only --tmpfs /tmp \
    -e HOTSPARK_CONFIG=/config/config.json \
    --mount type=bind,src=/var/lib/hotspark/cli,dst=/config \
    "hotspark/api:$version" node dist/packages/cli/src/main.js "$@"
  ;;
esac
