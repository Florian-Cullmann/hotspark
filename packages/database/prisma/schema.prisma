generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
 id String @id @default(uuid()) @db.Uuid
 email String @unique
 passwordHash String
 role String @default("admin")
 createdAt DateTime @default(now())
 tokens ApiToken[]
}
model ApiToken {
 id String @id @default(uuid()) @db.Uuid
 name String
 digest String @unique
 scopes String[]
 userId String @db.Uuid
 user User @relation(fields:[userId],references:[id])
 expiresAt DateTime
 revokedAt DateTime?
 createdAt DateTime @default(now())
}
model Project {
 id String @id @default(uuid()) @db.Uuid
 name String @unique
 spec Json
 encryptedSecrets String?
 desiredState String @default("stopped")
 observedState String @default("created")
 restoreOnDrift Boolean @default(true)
 revision Int @default(1)
 runtimeVersion Int @default(1)
 lastObservedAt DateTime?
 deletedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 services Service[]
 domains Domain[]
 deployments Deployment[]
 jobs Job[]
}
model Service {
 id String @id @default(uuid()) @db.Uuid
 projectId String @db.Uuid
 project Project @relation(fields:[projectId],references:[id])
 name String
 type String
 @@unique([projectId,name])
}
model Domain {
 id String @id @default(uuid()) @db.Uuid
 hostname String @unique
 projectId String @db.Uuid
 project Project @relation(fields:[projectId],references:[id])
 serviceName String
}
model Deployment {
 id String @id @default(uuid()) @db.Uuid
 projectId String @db.Uuid
 project Project @relation(fields:[projectId],references:[id])
 spec Json
 status String @default("queued")
 createdAt DateTime @default(now())
 jobs Job[]
}
model Job {
 id String @id @default(uuid()) @db.Uuid
 projectId String @db.Uuid
 project Project @relation(fields:[projectId],references:[id])
 deploymentId String? @db.Uuid
 deployment Deployment? @relation(fields:[deploymentId],references:[id])
 operation String
 payload Json?
 attempts Int @default(0)
 maxAttempts Int @default(3)
 availableAt DateTime @default(now())
 leaseUntil DateTime?
 workerId String?
 progress Int @default(0)
 events JobEvent[]
 status String @default("queued")
 error String?
 createdAt DateTime @default(now())
 startedAt DateTime?
 finishedAt DateTime?
 @@index([status,createdAt])
}
model AuditEvent {
 id String @id @default(uuid()) @db.Uuid
 actorId String
 action String
 resourceId String
 requestId String
 createdAt DateTime @default(now())
 @@index([createdAt])
}

model JobEvent {
 id String @id @default(uuid()) @db.Uuid
 jobId String @db.Uuid
 job Job @relation(fields:[jobId],references:[id])
 message String
 progress Int
 createdAt DateTime @default(now())
 @@index([jobId,createdAt])
}
model IdempotencyRecord {
 id String @id @default(uuid()) @db.Uuid
 actorId String
 key String
 requestHash String
 response Json
 createdAt DateTime @default(now())
 @@unique([actorId,key])
}
